# Copy to .env (which is gitignored). Picked up two different ways
# depending on how you run the app -- read both sections below, since one
# of them intentionally overrides values from the other:
#
# - `podman-compose up --build` (see README.md's Tor deployment section):
#   compose does its own ${VAR} substitution from this file, and only
#   reads DJANGO_SECRET_KEY/DB_NAME/DB_USER/DB_PASSWORD/ONION_HOSTNAME
#   from it -- compose.yaml sets DB_HOST/DB_PORT/REDIS_HOST/REDIS_PORT/
#   DJANGO_SECURE/DJANGO_DEBUG directly on the `app` service itself, so
#   the "local only" section below is never read in this path.
# - a plain local `manage.py runserver`/`migrate` (see README's Quick
#   Start): pc/settings.py loads this file directly (see issue #66), so
#   every line in this file applies, in order -- which is why the "local
#   only" section below repeats DB_NAME/DB_USER/DB_PASSWORD: python-dotenv
#   takes the LAST value when a key appears twice, so those three lines
#   deliberately override the ones above for this path only, matching
#   exactly the role/database Quick Start step 4 has you create.

# ── Used by podman-compose (production/Tor deployment) ─────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DB_NAME=telepathy
DB_USER=telepathy
DB_PASSWORD=replace-with-a-long-random-value

# Leave blank on first boot. After the tor container generates the hidden
# service's address, set this to that value (without the .onion suffix logic
# -- use the full hostname, e.g. abcd1234....onion) and restart the app
# service so it's accepted by ALLOWED_HOSTS.
ONION_HOSTNAME=

# ── Local (non-container) `manage.py runserver` only -- see top comment ────
# DJANGO_SECURE defaults to true (fails closed) and 301-redirects to HTTPS,
# which the dev server can't serve. DJANGO_DEBUG defaults to false. Both of
# these are what you almost always want for a plain local run.
DJANGO_SECURE=false
DJANGO_DEBUG=true
DB_HOST=localhost
DB_PORT=5432
# Overrides the DB_NAME/DB_USER/DB_PASSWORD above -- matches Quick Start
# step 4's `CREATE ROLE`/`CREATE DATABASE` example exactly.
DB_NAME=my_database
DB_USER=myproject_user
DB_PASSWORD=mysecretpassword
# Needed by the real-time (Channels) websocket transport -- install and
# start Redis locally too, not just Postgres (see README's Quick Start).
REDIS_HOST=localhost
REDIS_PORT=6379
