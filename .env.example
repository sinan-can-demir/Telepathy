# Copy to .env (which is gitignored) and fill in real values before running
# `podman-compose up --build`. See README.md's Tor deployment section.

DJANGO_SECRET_KEY=replace-with-a-long-random-value
DB_NAME=telepathy
DB_USER=telepathy
DB_PASSWORD=replace-with-a-long-random-value

# Leave blank on first boot. After the tor container generates the hidden
# service's address, set this to that value (without the .onion suffix logic
# -- use the full hostname, e.g. abcd1234....onion) and restart the app
# service so it's accepted by ALLOWED_HOSTS.
ONION_HOSTNAME=
